{
  "manifest_version": 3,
  "name": "Desviament - Proton Bus Mods",
  "version": "1.0",
  "description": "Direct download packages in protonbusmods.com",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "content_scripts": [
    {
      "matches": ["*://protonbusmods.com/*"],
      "js": ["content-script.js"]
    }
  ]
}
